{
  "name": "audioq",
  "version": "3.0.0",
  "description": "Queue audio in the browser: independent channels, playlists, sprites, captions, crossfades, ducking, lock-screen controls and iOS fixes. Zero dependencies, TypeScript.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node scripts/generate-default-api.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --max-warnings 0 src __tests__ scripts eslint.config.mjs jest.config.js jest.dist.config.js",
    "lint:fix": "eslint src __tests__ scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:update": "node scripts/validate/update-api-snapshot.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "validate:all": "node scripts/validate-all.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run validate:all",
    "publish:dry": "npm publish --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonycarpenter21/audioq.git"
  },
  "keywords": [
    "audio",
    "audio-queue",
    "queue",
    "playlist",
    "sound",
    "sound-effects",
    "sfx",
    "game-audio",
    "channel",
    "volume",
    "ducking",
    "fade",
    "crossfade",
    "audio-sprite",
    "sprite",
    "captions",
    "webvtt",
    "media-session",
    "lock-screen",
    "web-audio",
    "html5-audio",
    "ios",
    "autoplay",
    "preload",
    "typescript",
    "react",
    "svelte",
    "no-dependencies"
  ],
  "author": "Tony Carpenter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tonycarpenter21/audioq/issues"
  },
  "homepage": "https://tonycarpenter21.github.io/audio-queue-docs/",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^20.19.0 || ^22.13.0 || >=24"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      "minimatch": "^11.0.9"
    }
  }
}
