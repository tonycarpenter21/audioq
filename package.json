{
  "name": "audioq",
  "version": "3.0.0",
  "description": "Queue audio files on independent channels in the browser, with pause, fades, volume ducking and events. Zero dependencies.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node scripts/generate-default-api.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --max-warnings 0 src __tests__ scripts",
    "lint:fix": "eslint src __tests__ scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:update": "node scripts/validate/update-api-snapshot.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "validate:all": "node scripts/validate-all.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run validate:all",
    "publish:dry": "npm publish --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonycarpenter21/audioq.git"
  },
  "keywords": [
    "audio",
    "queue",
    "playlist",
    "sound",
    "channel",
    "ducking",
    "fade",
    "browser",
    "no dependencies"
  ],
  "author": "Tony Carpenter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tonycarpenter21/audioq/issues"
  },
  "homepage": "https://tonycarpenter21.github.io/audio-queue-docs/",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/jest": "^29.5.13",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.34.1"
  }
}
