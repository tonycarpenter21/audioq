{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "outDir": "./dist/cjs",
    "declaration": false,
    "removeComments": true,
    "sourceMap": false,
    "verbatimModuleSyntax": false,
    "isolatedDeclarations": false
  },
  "include": ["src/**/*"]
}
